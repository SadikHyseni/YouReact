{
    "manifest_version": 3,
    "name": " YouReact ",
    "version": "1.0.0",
    "description": "An AI-powered Chrome extension that recommends personalized YouTube videos by analyzing your real-time facial expressions. YouReact uses emotion detection to adapt video suggestions to your current mood, creating a more engaging and emotionally aware viewing experience.",
    "author": "Sadik hyseni",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": [
        "scripting"
    ],
    "host_permissions": [
        "https://*.youtube.com/*",
        "https://youtube.googleapis.com/*",
        "https://kmi44nr6kgwhtz3h2f4wsbt2qi0unatz.lambda-url.eu-west-2.on.aws/*"
    ],
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["content.js","face-api.min.js"],
            "type": "module"
        }
    ],
    "web_accessible_resources": [
        {
          "resources": ["models/*"],
          "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}